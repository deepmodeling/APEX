{
    "context_type": "Local",
    "run_command": "<calculator command, for example: srun lmp -in in.lammps>",
    "machine": {
        "batch_type": "Slurm",
        "context_type": "Local",
        "local_root": "./",
        "remote_root": "<cluster-visible work directory>",
        "clean_asynchronously": true
    },
    "resources": {
        "number_node": 1,
        "cpu_per_node": 1,
        "gpu_per_node": 0,
        "group_size": 1,
        "module_list": [],
        "custom_flags": [
            "#SBATCH --partition=<partition>",
            "#SBATCH --time=<walltime>"
        ]
    }
}
