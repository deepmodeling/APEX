# Python
__pycache__/
*.py[cod]
*.pyo

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Caches & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
*.log
dpdispatcher.log
.workflow.log

# Tools & editors
.vscode/
.idea/
.DS_Store
AGENTS.md

# User-generated workflow files
reference
relaxation
eos_*
elastic_*
template
potential
all_result.json
usage
confs

# Keep packaged skill reference docs (overrides the bare `reference` rule above)
!apex/skills/
!apex/skills/**/
!apex/skills/**/reference/
!apex/skills/**/reference/**

# dflow debug folders generated by examples or local runs
**/dflow_debug/
# Generated MatMaster skill archive
apex-flow.zip

# Exclude arbitrary DeePMD training/source checkpoints, but keep the one
# authoritative single-task DPA4 model bundled by apex-flow.
apex/skills/apex-flow/models/**/*.pt
!apex/skills/apex-flow/models/DPA4-alloytongqi/model.pt
apex/skills/apex-flow/models/**/*.partial
