FROM registry.bohrium.dp.tech/dptech/deepmd-kit:3.1.3

ARG PHONOLAMMPS_VERSION=0.10.1
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PATH="/opt/deepmd-kit-3.1.3/bin:${PATH}"

RUN python -m pip install --no-cache-dir --proxy "" \
        --index-url "${PIP_INDEX_URL}" \
        "phonoLAMMPS==${PHONOLAMMPS_VERSION}" \
    && python -c "from importlib.metadata import version; import phonolammps, phonopy; from lammps import lammps; engine = lammps(cmdargs=['-log', 'none', '-screen', 'none']); engine.close(); print('phonoLAMMPS', version('phonoLAMMPS'), 'verified')"
